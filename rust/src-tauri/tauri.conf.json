{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serica",
  "version": "0.4.1",
  "identifier": "com.serica.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Serica",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "A9A139A1-D012-5D8E-9A62-712E63D396AB"
      }
    },
    "publisher": "Serica",
    "shortDescription": "Serica, an open-source Arc-style browser for Windows",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFRDEzOTIzNjAxNjQ1RDkKUldUWlJSWmdJem5STGpvemdtU0U3eURYSStMMnVtTzA4UFBmWk1LWXNHNXV4dm1Zam1xLzg4VUkK",
      "endpoints": [
        "https://github.com/icesucksatguitar/Serica/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
