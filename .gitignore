# ==============================================================================
# Neutrino Browser - Git Ignore (Root)
# ==============================================================================

# Node / Web Frontend
**/node_modules/
**/dist/
**/dist-*/
**/release/
**/out/
**/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Rust / Cargo / Tauri
**/target/
**/*.rs.bk
**/Cargo.lock
rust/src-tauri/target/

# Python & Cache
**/__pycache__/
*.py[cod]
.venv/
venv/
env/

# Agent / editor workspace files
.kiro/

# OS & Temp
Thumbs.db
[Dd]esktop.ini
.DS_Store
*.tmp
*.temp
scratch/
rust/scratch/
**/tests/*.png

# Toolchain bin wrappers
rust/src-tauri/.tools/*.exe
rust/src-tauri/.tools/*.dll

